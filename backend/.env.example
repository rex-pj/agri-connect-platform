# Copy to backend/.env (or set real environment variables, which always win).
# One variable per line; the comment says what goes wrong when it is wrong.

# Postgres with PostGIS. Wrong/unreachable: the server exits at startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agri_connect_db
# Optional read pool (a replica) for lag-tolerant reads. Unset: reads share DATABASE_URL. Pointing at a lagging replica: permission changes apply late.
DATABASE_READ_URL=
# host:port to listen on. Unset: 0.0.0.0:3000. Port already in use: startup refuses.
BIND_ADDR=0.0.0.0:3000
# At least 32 random bytes (e.g. `openssl rand -hex 32`). Shorter: startup refuses. Changing it logs everyone out.
JWT_SECRET=
# Public origin of the site (what the address bar shows), no trailing slash. Reset links point at it and our own forms must post from it: wrong, and every form is refused as cross-site. Unset: http://localhost:3000.
APP_URL=http://localhost:3000
# Comma-separated extra browser origins allowed to call the API and to send non-GET requests (APP_URL is always allowed). Malformed: startup refuses.
CORS_ORIGINS=
# Reverse proxies in front whose X-Forwarded-For entry is trusted (1 behind Caddy). 0 behind a proxy: all users share one rate limit. Too high: clients can forge their address.
TRUSTED_PROXY_HOPS=0
# true only when TLS terminates in front of the app. true over plain HTTP: browsers refuse the site for a year (HSTS).
HTTPS_ENABLED=false
# dev or prod; picks environments/.env.<APP_ENV> when there is no .env. Wrong value: that file is silently not loaded.
APP_ENV=dev
# json in production. Anything else: human-readable lines that log shippers cannot parse.
LOG_FORMAT=
# tracing filter; targets are crate names (web, application, infrastructure, domain). A target that does not exist silences our logs. Plain "info" logs every SQL statement. Empty or invalid: default filter.
RUST_LOG=info,sea_orm=warn,sqlx=warn
# SMTP relay for password-reset email. Unset: links are written to the log instead (startup WARN) and nobody receives email.
SMTP_HOST=
# STARTTLS port. Wrong: every send fails and is logged; users get no email.
SMTP_PORT=587
# Set both or neither. Only one set: startup refuses.
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address. Not a valid address: startup refuses when SMTP_HOST is set.
FROM_EMAIL=no-reply@agri-connect.vn
# Where pages Rust does not serve yet are proxied (the SvelteKit server, http only). Unset: those pages answer 404 (startup WARN). Removed in S20.
LEGACY_FRONTEND_URL=http://localhost:5173
# Private Google Cloud Storage bucket for product images (name only, no gs://). Unset: UPLOAD_DIR is used (startup WARN). Wrong name or no access for the VM service account: every upload fails with an internal error.
GCS_BUCKET=
# Directory for uploads when GCS_BUCKET is unset; created if missing. Inside a container without a volume: images vanish on redeploy.
UPLOAD_DIR=./data/uploads
# Largest accepted upload in bytes (the photo before we shrink it). Unset: 5242880 (5 MiB). Too low: ordinary phone photos are refused.
UPLOAD_MAX_BYTES=5242880
# Shown in every page title and description meta. Unset: "Agri-Connect" and the default tagline.
SITE_NAME=Agri-Connect
SITE_DESCRIPTION=
# Integration tests only: a database on a server where this user may CREATE DATABASE. Unset: database tests stay ignored.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
