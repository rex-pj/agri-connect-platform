# Copy to backend/.env (or set real environment variables, which always win).
# One variable per line; the comment says what goes wrong when it is wrong.

# Postgres with PostGIS. Wrong/unreachable: the server exits at startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agri_connect_db
# Optional: the role that owns the schema, used only to run the migrations at startup. Unset: DATABASE_URL migrates too. In production DATABASE_URL is agri_app (rows only) and this is agri_owner (deploy/db-init/roles.psql); wrong: startup stops on the first migration.
MIGRATION_DATABASE_URL=
# Optional read pool (a replica) for lag-tolerant reads. Unset: reads share DATABASE_URL. Nothing reads from it yet: sessions and permissions always use DATABASE_URL, so a revocation never waits for a replica.
DATABASE_READ_URL=
# Connections in the pool. Unset: 20. Too low: pages fail with a database error while the pool is busy (a request waits 5 s for one). Higher than Postgres' max_connections allows: startup fails.
DB_MAX_CONNECTIONS=20
# Seconds one SQL statement may run before Postgres cancels it. Unset: 20. Keep it under the 30 s a request may take; too low: the demand report or a large list fails with an internal error.
DB_STATEMENT_TIMEOUT_SECS=20
# host:port to listen on. Unset: 0.0.0.0:5173. Port already in use: startup refuses.
BIND_ADDR=0.0.0.0:5173
# At least 32 random bytes (e.g. `openssl rand -hex 32`). Shorter: startup refuses. Changing it logs everyone out.
JWT_SECRET=
# What the first-admin form (/setup, POST /api/admin/setup) must be given, at least 16 characters. Unset: whoever reaches the form first becomes the admin; with APP_ENV=prod and no admin yet, startup refuses.
SETUP_TOKEN=
# Development only: the one password of every account `agri-connect demo-data` creates (the demo providers and partners). Must pass the sign-up rules. Never set in production: that command refuses to run with APP_ENV=prod.
DEMO_ACCOUNT_PASSWORD=
# Days an unused browser session survives (refresh token). Unset: 30. Too short: farmers who open the app weekly keep having to log in.
REFRESH_TOKEN_DAYS=30
# Public origin of the site (what the address bar shows), no trailing slash. Reset links point at it and our own forms must post from it: wrong, and every form is refused as cross-site. Unset: http://localhost:5173.
APP_URL=http://localhost:5173
# Comma-separated extra browser origins allowed to call the API. They may send non-GET requests only without a session cookie of ours (APP_URL is always allowed). Malformed: startup refuses.
CORS_ORIGINS=
# The Zalo app's secret key (developers.zalo.me → the app → settings): lets the server read the Zalo Mini App's location and phone tokens. Unset: the Mini App asks for an area and a typed phone. The Mini App calls the API from https://h5.zdn.vn: add it to CORS_ORIGINS.
ZALO_APP_SECRET=
# Reverse proxies in front whose X-Forwarded-For entry is trusted (1 behind Caddy). 0 behind a proxy: all users share one rate limit. Too high: clients can forge their address.
TRUSTED_PROXY_HOPS=0
# true only when TLS terminates in front of the app. true over plain HTTP: browsers refuse the site for a year (HSTS).
HTTPS_ENABLED=false
# dev or prod; picks environments/.env.<APP_ENV> when there is no .env. Wrong value: that file is silently not loaded.
APP_ENV=dev
# json in production. Anything else: human-readable lines that log shippers cannot parse.
LOG_FORMAT=
# tracing filter; targets are crate names (web, application, infrastructure, domain). A target that does not exist silences our logs. Plain "info" logs every SQL statement. Empty or invalid: default filter.
RUST_LOG=info,sea_orm=warn,sqlx=warn
# SMTP relay for password-reset email. Unset: links are written to the log instead (startup WARN) and nobody receives email; with APP_ENV=prod, startup refuses.
SMTP_HOST=
# STARTTLS port. Wrong: every send fails and is logged; users get no email.
SMTP_PORT=587
# Set both or neither. Only one set: startup refuses.
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address. Not a valid address: startup refuses when SMTP_HOST is set.
FROM_EMAIL=no-reply@agri-connect.vn
# Private Cloudflare R2 bucket for product images (production). Set R2_ACCOUNT_ID and the three others must be set too (startup refuses). Credentials: an R2 API token's S3 Access Key ID / Secret Access Key, Object Read & Write on that bucket. Wrong ones: every upload fails with an internal error.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private Google Cloud Storage bucket for product images when R2_ACCOUNT_ID is unset (name only, no gs://). Unset: UPLOAD_DIR is used (startup WARN). Wrong name or no access for the VM service account: every upload fails with an internal error.
GCS_BUCKET=
# Directory for uploads when no R2 or GCS bucket is set; created if missing. Inside a container without a volume: images vanish on redeploy.
UPLOAD_DIR=./data/uploads
# Largest accepted upload in bytes (the photo before we shrink it). Unset: 5242880 (5 MiB). Too low: ordinary phone photos are refused.
UPLOAD_MAX_BYTES=5242880
# The default name and description in every page title, meta and email. An admin's own (/admin/settings, "Nhận diện") wins; these show while those are empty and on the error page of a database outage. Unset: "Agri-Connect" and the locale's tagline (site.description in web/locales/vi.toml).
SITE_NAME=Agri Connect
SITE_DESCRIPTION=
# The footer's help lines (phone, Zalo, email), the sign-up and hire-request switches and the business limits are not here: an admin sets them at /admin/settings.
# Integration tests only: a database on a server where this user may CREATE DATABASE. Unset: database tests stay ignored.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
