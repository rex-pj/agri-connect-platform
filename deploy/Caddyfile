# The site is served behind Cloudflare's proxy (orange cloud, SSL mode
# "Full (strict)"): every connection reaches Caddy from a Cloudflare edge.
# Everything goes to the Rust server, which serves every page and the API.
{
	servers {
		# Cloudflare's ranges (https://www.cloudflare.com/ips/). Only a
		# connection from one of them may name the client with
		# CF-Connecting-IP; anyone else is the client themselves. A range
		# Cloudflare adds and missing here does not fail loudly: its visitors
		# share one rate-limit bucket. Keep the firewall rule in step
		# (deploy/README.md, step 4).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# The Cloudflare Origin Certificate (SSL/TLS → Origin Server, covering DOMAIN
# and *.DOMAIN): trusted by Cloudflare, not by browsers, which never reach this
# port directly. Written from Secret Manager by remote-deploy.sh.
(origin_tls) {
	tls /certs/origin.pem /certs/origin.key
}

{$DOMAIN} {
	import origin_tls
	encode zstd gzip
	reverse_proxy web:8080 {
		# Exactly one address, the visitor's: TRUSTED_PROXY_HOPS=1 reads it.
		# Overwritten rather than appended, so a client's own header is never
		# taken.
		header_up X-Forwarded-For {client_ip}
	}
}

www.{$DOMAIN} {
	import origin_tls
	redir https://{$DOMAIN}{uri} permanent
}
